# LLM Provider: "anthropic", "deepseek", or "groq"
LLM_PROVIDER=deepseek

# API Keys (only the one matching your provider is required)
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Model override (optional, defaults per provider):
#   anthropic  -> claude-sonnet-4-20250514
#   deepseek   -> deepseek-chat
#   groq       -> llama-3.3-70b-versatile
# MODEL=deepseek-chat

AGENT_NAME=LiteClaw
WORKSPACE_DIR=./workspace
MAX_TOOL_DEPTH=10
LOG_LEVEL=info
CHANNEL=cli
PORT=3000
