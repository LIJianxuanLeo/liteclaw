# LLM Provider: "gemini", "groq", or "anthropic"
LLM_PROVIDER=gemini

# API Key (for whichever provider you chose)
API_KEY=your-api-key-here

# Model override (optional, defaults per provider):
#   gemini     -> gemini-2.5-flash
#   groq       -> llama-3.3-70b-versatile
#   anthropic  -> claude-sonnet-4-20250514
# MODEL=gemini-2.5-flash

AGENT_NAME=LiteClaw

# WhatsApp allowlist (comma-separated phone numbers, no + prefix)
WHATSAPP_ALLOWLIST=1234567890

# Data directories
DATA_DIR=./data
NOTES_DIR=./notes

LOG_LEVEL=info
